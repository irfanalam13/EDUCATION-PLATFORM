# Copy to backend/.env and fill in. NEVER commit the real .env.
# ── LOCAL ──
DEBUG=True
DEV_MODE=True
SECRET_KEY=change-me-generate-a-strong-random-value
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081

# ── PRODUCTION (set in the Render dashboard) ──
# DEBUG=False
# DJANGO_SETTINGS_MODULE=config.settings.prod
# ALLOWED_HOSTS=education-platform-f96b.onrender.com
# CORS_ALLOWED_ORIGINS=https://education-platform-psi.vercel.app
# CSRF_TRUSTED_ORIGINS=https://education-platform-psi.vercel.app,https://education-platform-f96b.onrender.com

# ---- AI / RAG (chat answer generation) ----
# Primary provider: gemini | claude. Gemini answers from general knowledge when
# no RAG data is uploaded. Key: https://aistudio.google.com/apikey
AI_CHAT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Optional Claude fallback. Key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
AI_CHAT_MODEL=claude-opus-4-8
AI_RAG_TOP_K=5
AI_MAX_UPLOAD_MB=20
# Embeddings provider: local | voyage | openai
AI_EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3.5
OPENAI_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Google OAuth (comma-separated client IDs: web,android,ios,expo) ----
GOOGLE_OAUTH_CLIENT_IDS=

# ---- Storage (S3-compatible; optional) ----
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=

# ---- Billing / payments (apps.billing) ----
# Currency for plans/invoices (Nepal-focused default).
BILLING_DEFAULT_CURRENCY=NPR
# With NO gateway keys set, the MANUAL gateway handles checkout offline and the
# webhook is authenticated by MANUAL_WEBHOOK_TOKEN — the whole flow still works.
MANUAL_WEBHOOK_TOKEN=
# Stripe (international cards). https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Khalti (Nepal). https://admin.khalti.com -> keys
KHALTI_SECRET_KEY=
KHALTI_SANDBOX=True
# eSewa (Nepal). EPAYTEST is the public sandbox merchant.
ESEWA_SECRET_KEY=
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SANDBOX=True

# ---- Production only (DEV_MODE=False) ----
# On Render, set DATABASE_URL (single connection string) instead of the DB_* vars.
# DATABASE_URL=postgres://user:pass@host:5432/edu_platform
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=edu_platform
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
# REDIS_URL=redis://127.0.0.1:6379/1
