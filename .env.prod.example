# =============================================================================
# Production environment for docker-compose.prod.yml
#   cp .env.prod.example .env.prod   then fill in the values marked <CHANGE ME>.
# This single file is the source of truth for every service (Django reads DB_*,
# Postgres reads POSTGRES_*, Next.js reads BACKEND_URL). .env.prod is gitignored.
# =============================================================================

# ---- Django core ----------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=<CHANGE ME - long random string>
DEBUG=0
DEV_MODE=0
# Comma-separated public hostnames (no scheme). localhost/127.0.0.1 are added automatically.
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Set to 1 ONLY after HTTPS is live (see DEPLOYMENT.md). Leave 0 for HTTP bootstrap.
SECURE_SSL_REDIRECT=0

# ---- PostgreSQL (read by the `db` container) ------------------------------
POSTGRES_DB=edu
POSTGRES_USER=edu
POSTGRES_PASSWORD=<CHANGE ME - strong db password>

# ---- Database (read by Django; MUST match the POSTGRES_* values above) -----
DB_ENGINE=django.db.backends.postgresql
DB_NAME=edu
DB_USER=edu
DB_PASSWORD=<CHANGE ME - same as POSTGRES_PASSWORD>
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ---- Redis / Celery (service name `redis` on the compose network) ---------
USE_REDIS=1
USE_CELERY=1
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_CONCURRENCY=4

# ---- JWT ------------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# ---- Gunicorn -------------------------------------------------------------
GUNICORN_WORKERS=3

# ---- Email ----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=EduPlatform <no-reply@yourdomain.com>
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1

# ---- AI / RAG (Claude) ----------------------------------------------------
ANTHROPIC_API_KEY=
AI_CHAT_MODEL=claude-opus-4-8
AI_EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
OPENAI_API_KEY=

# ---- Google OAuth (comma-separated client IDs: web,android,ios,expo) ------
GOOGLE_OAUTH_CLIENT_IDS=

# ---- Object storage (optional; recommended for media in prod) -------------
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# ---- Observability (optional) ---------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ---- Frontend (Next.js) ---------------------------------------------------
# Runtime: the Next server proxies browser calls (/api/backend/*) to this URL.
BACKEND_URL=http://backend:8000
# Build-time (inlined into the browser bundle by docker-compose build args):
NEXT_PUBLIC_API_BASE_URL=/api/backend
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- Ops ------------------------------------------------------------------
BACKUP_RETENTION_DAYS=7
LOG_LEVEL=INFO
