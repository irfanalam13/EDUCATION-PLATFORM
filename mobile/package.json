{
  "name": "edu-platform-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:offline": "set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo start",
    "android": "set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo start --android",
    "ios": "set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo start --ios",
    "web": "set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-auth-session": "~6.0.3",
    "expo-device": "~7.0.3",
    "expo-document-picker": "~13.0.3",
    "expo-font": "~13.0.4",
    "expo-notifications": "~0.29.14",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.86.0",
    "react-native-chart-kit": "^6.12.3",
    "react-native-safe-area-context": "4.12.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "babel-plugin-module-resolver": "^5.0.2",
    "typescript": "^5.6.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "comment": "chart-kit is a pure-JS wrapper over react-native-svg (New-Arch compatible); directory just hasn't tested it.",
        "exclude": ["react-native-chart-kit"]
      }
    }
  }
}
